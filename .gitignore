# Сборка.
/target/
**/*.rs.bk

# Секреты и локальные настройки: у каждого свои.
config.toml
/.env
/.env.*
!/.env.example

# Скомпилированные библиотеки не коммитим.
*.dll
*.so
*.dylib
*.lib

# Нативная библиотека Vosk и модели ставятся пользователем, не коммитим.
libvosk.dll
libvosk.so
libvosk.dylib
libvosk.lib
vosk-model-*/
/models/

# Мусор редакторов и ОС.
.idea/
.vscode/
.DS_Store
Thumbs.db
